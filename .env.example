# AWS Configuration (auto-set by Lambda, configure manually for local dev)
AWS_REGION=us-east-1
S3_BUCKET_UPLOADS=c2pa-api-dev-uploads-xxxxx
S3_BUCKET_SIGNED=c2pa-api-dev-signed-xxxxx
DYNAMODB_TABLE_MANIFESTS=c2pa-api-dev-manifests
SQS_QUEUE_MANIFEST_JOBS=https://sqs.us-east-1.amazonaws.com/ACCOUNT_ID/c2pa-api-dev-manifest-jobs
SECRET_ARN_C2PA_KEYS=arn:aws:secretsmanager:us-east-1:ACCOUNT_ID:secret:c2pa-api-dev-c2pa-keys-xxxxx
KMS_KEY_ID=arn:aws:kms:us-east-1:ACCOUNT_ID:key/xxxxx

# Application
NODE_ENV=development
PORT=3000

# C2PA Signer Mode
# Set to 'true' for development/testing (uses test signer)
# Set to 'false' for production (uses real keys from Secrets Manager)
USE_TEST_SIGNER=true

# AWS Credentials (for local development only)
# AWS_ACCESS_KEY_ID=your_access_key
# AWS_SECRET_ACCESS_KEY=your_secret_key
